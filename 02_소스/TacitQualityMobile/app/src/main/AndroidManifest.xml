<?xml version="1.0" encoding="utf-8"?>
<!--
  품질검사 지원 APP — 모바일 모듈 / ㈜스네일 / 대외비
  검사 루프(P1) 동안 이 앱은 주머니 안에서 스트림 중계기로만 동작한다.
  작업자가 화면을 보는 시점은 P0 · P3 · P5 · 조회 네 번뿐이다.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- 중계는 교대 내내 끊기면 안 된다 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".TacitQApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.TacitQ"
        android:usesCleartextTraffic="true">
        <!-- 개발 단계: HMD 영상(http)·로컬 엣지(ws)가 평문이다. 운영 엣지는 wss 로 바꾸고 이 줄을 지운다. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          검사 오케스트레이터 (C3 상태 기계 + C4 HmdRenderer + C5 LocalStore).
          이벤트를 한 줄로 세워 단일 스레드에서 처리한다. C2 StreamRelay(HMD 영상 → 엣지) 포함. C1 준비 후 실물 BLE 를 붙인다.
        -->
        <service
            android:name=".service.InspectionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
